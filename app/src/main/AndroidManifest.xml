<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.scootroute.mopednav">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:label="ScootRoute"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3254889504013066~8633172639" />
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <activity android:name=".AuthActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WaiverActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".HazardReportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".HelpActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".AccountActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".MopedRentalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <service android:name=".NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
