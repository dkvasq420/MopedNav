<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1E2A3A"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Name + Rating row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvShopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shop Name"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvShopArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Area"
                    android:textColor="#00D4FF"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvShopRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.5"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pricing -->
        <TextView
            android:id="@+id/tvShopPricing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mopeds from $35/day"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <!-- Hours -->
        <TextView
            android:id="@+id/tvShopHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open 8am–6pm"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnShopCall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                app:cardBackgroundColor="#2A3A4A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="&#128222; Call"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnShopMap"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                app:cardBackgroundColor="#2A3A4A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="&#128506; Map"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnShopBook"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#00D4FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Book Now"
                    android:textColor="#0A0E1A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
