<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F1620"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnRentalBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="12dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="&#8592;"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#128757; Rent a Moped"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvRentalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading shops..."
                    android:textColor="#00D4FF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="All"
                android:textColor="#0A0E1A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/btn_cyan_rounded" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Waikiki"
                android:textColor="#00D4FF"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/btn_outline_cyan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Kailua"
                android:textColor="#00D4FF"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/btn_outline_cyan" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shop list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/llRentalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </ScrollView>
</LinearLayout>
