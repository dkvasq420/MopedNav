<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAccountBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="12dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <TextView android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="&#8592;" android:textColor="#FFFFFF"
                    android:textSize="18sp" android:gravity="center" />
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upgrade Account"
                android:textColor="#FFFFFF"
                android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvCurrentPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Plan: Free"
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Free tier -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1E2A3A"
            app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FREE" android:textColor="#888888"
                    android:textSize="16sp" android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Basic navigation\n✓ Freeway avoidance\n✓ Hazard reporting (5/day)\n✓ Route history (7 days)\n✗ Ads shown"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Plus tier -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnUpgradePlus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1A1E2A3A"
            app:cardCornerRadius="20dp" app:cardElevation="4dp"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PLUS" android:textColor="#FF9500"
                        android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$2.99/mo"
                        android:textColor="#FF9500"
                        android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ No ads\n✓ Save unlimited routes\n✓ Traffic overlay\n✓ Priority routing\n✓ Route history (90 days)"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5" />
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap to upgrade &#8250;"
                    android:textColor="#FF9500"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pro tier -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnUpgradePro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1A00D4FF"
            app:cardCornerRadius="20dp" app:cardElevation="8dp"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRO &#11088;" android:textColor="#00D4FF"
                        android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5.99/mo"
                        android:textColor="#00D4FF"
                        android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Everything in Plus\n✓ Custom routing profiles\n✓ Vehicle garage (unlimited)\n✓ Advanced hazard analytics\n✓ Priority support\n✓ Offline caching (coming soon)"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5" />
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Most Popular — Tap to upgrade &#8250;"
                    android:textColor="#00D4FF"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnRestorePurchase"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp" app:cardElevation="0dp"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Restore Previous Purchase"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
